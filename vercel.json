{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/firm", "destination": "/", "statusCode": 302 },
    { "source": "/firm.html", "destination": "/", "statusCode": 302 },
    { "source": "/practices", "destination": "/", "statusCode": 302 },
    { "source": "/practices.html", "destination": "/", "statusCode": 302 },
    { "source": "/litigation", "destination": "/", "statusCode": 302 },
    { "source": "/litigation.html", "destination": "/", "statusCode": 302 },
    { "source": "/commercial-litigation", "destination": "/", "statusCode": 302 },
    { "source": "/commercial-litigation.html", "destination": "/", "statusCode": 302 },
    { "source": "/environmental-disputes", "destination": "/", "statusCode": 302 },
    { "source": "/environmental-disputes.html", "destination": "/", "statusCode": 302 },
    { "source": "/product-liability", "destination": "/", "statusCode": 302 },
    { "source": "/product-liability.html", "destination": "/", "statusCode": 302 },
    { "source": "/white-collar", "destination": "/", "statusCode": 302 },
    { "source": "/white-collar.html", "destination": "/", "statusCode": 302 },
    { "source": "/ip-trade-secrets", "destination": "/", "statusCode": 302 },
    { "source": "/ip-trade-secrets.html", "destination": "/", "statusCode": 302 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
